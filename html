<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ngành Điện Tử Viễn Thông | Kỷ Nguyên Kết Nối Số & Vi Mạch Bán Dẫn</title>
    <!-- Font chữ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Thư viện QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        :root {
            --bg-color: #050811;
            --card-bg: rgba(13, 22, 41, 0.7);
            --primary-cyan: #00f0ff;
            --secondary-purple: #7000ff;
            --accent-pink: #ff007f;
            --text-main: #e2e8f0;
            --text-dim: #94a3b8;
            --border-glow: rgba(0, 240, 255, 0.3);
            --font-title: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-body);
            font-size: 18px;
            line-height: 1.6;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(112, 0, 255, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(0, 240, 255, 0.15) 0%, transparent 40%);
            background-attachment: fixed;
        }

        /* Lưới nền Cyberpunk Grid */
        .bg-grid {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            z-index: -1;
            pointer-events: none;
        }

        /* Header Navigation */
        header {
            position: sticky;
            top: 0;
            background: rgba(5, 8, 17, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 240, 255, 0.2);
            z-index: 1000;
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: var(--font-title);
            font-weight: 900;
            font-size: 1.4rem;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo span { color: var(--primary-cyan); }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        nav a {
            color: var(--text-main);
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        nav a:hover {
            color: var(--primary-cyan);
            text-shadow: 0 0 10px var(--primary-cyan);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Section Styles */
        section {
            padding: 5rem 0;
        }

        .section-title {
            font-family: var(--font-title);
            font-size: 2.2rem;
            text-align: center;
            margin-bottom: 3rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #fff;
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-cyan), var(--secondary-purple));
            margin: 10px auto 0;
            border-radius: 2px;
            box-shadow: 0 0 10px var(--primary-cyan);
        }

        /* Hero Section */
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: center;
            gap: 3rem;
            min-height: 80vh;
            padding-top: 2rem;
        }

        .hero-text h1 {
            font-family: var(--font-title);
            font-size: 3rem;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, #fff 30%, var(--primary-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
        }

        .hero-text p {
            color: var(--text-dim);
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }

        .cta-btn {
            display: inline-block;
            padding: 12px 32px;
            background: transparent;
            color: var(--primary-cyan);
            border: 2px solid var(--primary-cyan);
            font-family: var(--font-title);
            font-size: 1rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
            border-radius: 4px;
        }

        .cta-btn:hover {
            background: var(--primary-cyan);
            color: #000;
            box-shadow: 0 0 30px var(--primary-cyan);
        }

        /* Hero Card Display */
        .hero-visual {
            background: var(--card-bg);
            border: 1px solid var(--border-glow);
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.1);
            backdrop-filter: blur(8px);
        }

        /* Wave Simulation Canvas */
        .canvas-container {
            margin-top: 15px;
            background: #000;
            border-radius: 8px;
            border: 1px solid rgba(0, 240, 255, 0.3);
            overflow: hidden;
        }

        canvas {
            display: block;
            width: 100%;
            height: 150px;
        }

        .controls {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-small {
            padding: 6px 14px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-glow);
            color: var(--text-main);
            border-radius: 4px;
            cursor: pointer;
            font-family: var(--font-body);
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-small.active, .btn-small:hover {
            background: var(--primary-cyan);
            color: #000;
        }

        /* Section: Các Lĩnh Vực */
        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 2rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 2rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 3px;
            background: linear-gradient(90deg, var(--primary-cyan), var(--secondary-purple));
            opacity: 0;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-8px);
            border-color: var(--primary-cyan);
            box-shadow: 0 10px 30px rgba(0, 240, 255, 0.15);
        }

        .card:hover::before { opacity: 1; }

        .card-icon {
            font-size: 2.5rem;
            color: var(--primary-cyan);
            margin-bottom: 1rem;
        }

        .card h3 {
            font-family: var(--font-title);
            font-size: 1.3rem;
            color: #fff;
            margin-bottom: 0.8rem;
        }

        .card p {
            color: var(--text-dim);
            font-size: 1rem;
        }

        /* Section: QR Code Tool */
        .qr-section {
            background: linear-gradient(180deg, transparent, rgba(112, 0, 255, 0.05), transparent);
        }

        .qr-box {
            background: var(--card-bg);
            border: 1px solid var(--primary-cyan);
            border-radius: 12px;
            padding: 2.5rem;
            max-width: 650px;
            margin: 0 auto;
            text-align: center;
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.15);
        }

        .input-group {
            display: flex;
            gap: 10px;
            margin: 1.5rem 0;
        }

        .input-group input {
            flex: 1;
            padding: 12px 16px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border-glow);
            border-radius: 6px;
            color: #fff;
            font-family: var(--font-body);
            font-size: 1rem;
            outline: none;
        }

        .input-group input:focus {
            border-color: var(--primary-cyan);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        }

        .qr-display {
            background: #ffffff;
            padding: 15px;
            display: inline-block;
            border-radius: 10px;
            margin: 1.5rem 0 1rem;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
        }

        .qr-actions {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .url-text {
            word-break: break-all;
            color: var(--primary-cyan);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        /* Footer */
        footer {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 3rem 0 1.5rem;
            text-align: center;
            color: var(--text-dim);
            font-size: 0.95rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            header { flex-direction: column; gap: 1rem; }
            .hero { grid-template-columns: 1fr; text-align: center; }
            .hero-text h1 { font-size: 2.2rem; }
            .input-group { flex-direction: column; }
        }
    </style>
</head>
<body>

    <div class="bg-grid"></div>

    <!-- Header Navigation -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-microchip"></i>
            ECE <span>HUB</span>
        </div>
        <nav>
            <ul>
                <li><a href="#about">Tổng Quan</a></li>
                <li><a href="#fields">Lĩnh Vực</a></li>
                <li><a href="#careers">Cơ Hội</a></li>
                <li><a href="#qr-tool">Mã QR Web</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <!-- Hero Section -->
        <section class="hero" id="about">
            <div class="hero-text">
                <h1>Điện Tử Viễn Thông</h1>
                <p>Ngành công nghệ cốt lõi kiến tạo mạng internet 5G/6G, chip bán dẫn, hệ thống thông minh IoT và hạ tầng kết nối toàn cầu.</p>
                <a href="#qr-tool" class="cta-btn"><i class="fa-solid fa-qrcode"></i> Lấy QR Trang Web</a>
            </div>

            <div class="hero-visual">
                <h3 style="font-family: var(--font-title); font-size: 1.1rem; color: var(--primary-cyan);">
                    <i class="fa-solid fa-wave-square"></i> Mô Phỏng Tín Hiệu Sóng
                </h3>
                <div class="canvas-container">
                    <canvas id="waveCanvas"></canvas>
                </div>
                <div class="controls">
                    <button class="btn-small active" onclick="setWave('sine')">Sóng Sine (Analog)</button>
                    <button class="btn-small" onclick="setWave('am')">Điều Chế AM</button>
                    <button class="btn-small" onclick="setWave('digital')">Tín Hiệu Số (Digital)</button>
                </div>
            </div>
        </section>

        <!-- Lĩnh vực chính -->
        <section id="fields">
            <h2 class="section-title">Trụ Cột Công Nghệ</h2>
            <div class="grid-cards">
                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-satellite-dish"></i></div>
                    <h3>Mạng & Viễn Thông 5G/6G</h3>
                    <p>Nghiên cứu và phát triển mạng thông tin di động tốc độ cao, vệ tinh truyền thông và hạ tầng truyền dẫn cáp quang xuyên lục địa.</p>
                </div>
                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-memory"></i></div>
                    <h3>Thiết Kế Vi Mạch Bán Dẫn</h3>
                    <p>Thiết kế các dòng Chipset, vi xử lý SoC, mạch tích hợp (IC/VLSI) – trái tim công nghệ của smartphone, máy tính và thiết bị AI.</p>
                </div>
                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-network-wired"></i></div>
                    <h3>IoT & Lập Trình Nhúng</h3>
                    <p>Lập trình vi điều khiển (ARM, STM32, ESP32) kết nối cảm biến xây dựng nhà thông minh, xe tự lái và hệ thống công nghiệp tự động.</p>
                </div>
                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-sliders"></i></div>
                    <h3>Xử Lý Tín Hiệu & AI</h3>
                    <p>Lọc, phân tích và mã hóa tín hiệu âm thanh, hình ảnh, radar, áp dụng trí tuệ nhân tạo nhận diện khuôn mặt và giọng nói.</p>
                </div>
            </div>
        </section>

        <!-- Cơ hội nghề nghiệp -->
        <section id="careers">
            <h2 class="section-title">Cơ Hội Nghề Nghiệp</h2>
            <div class="grid-cards">
                <div class="card">
                    <h3>Kỹ Sư Thiết Kế Vi Mạch (IC Design)</h3>
                    <p>Làm việc tại các tập đoàn bán dẫn toàn cầu hàng đầu như Viettel High Tech, FPT Semiconductor, Qualcomm, Intel, Synopsys...</p>
                </div>
                <div class="card">
                    <h3>Kỹ Sư Hạ Tầng Mạng Viễn Thông</h3>
                    <p>Vận hành, tối ưu mạng vô tuyến và cáp quang cho các nhà mạng Viettel, VNPT, Mobifone...</p>
                </div>
                <div class="card">
                    <h3>Kỹ Sư Lập Trình Nhúng (Embedded Software)</h3>
                    <p>Phát triển phần mềm điều khiển thiết bị điện tử, ô tô thông minh (VinFast, Bosch, LG Electronics...).</p>
                </div>
            </div>
        </section>

        <!-- Công cụ QR Code -->
        <section class="qr-section" id="qr-tool">
            <h2 class="section-title">Mã QR Đường Link Trang Web</h2>
            <div class="qr-box">
                <p style="color: var(--text-dim);">Dưới đây là mã QR dẫn trực tiếp tới trang web này. Bạn có thể quét trực tiếp bằng Zalo/Camera hoặc tải ảnh về máy.</p>
                
                <div class="input-group">
                    <input type="text" id="qrInput" placeholder="Nhập đường link..." />
                    <button class="cta-btn" style="padding: 10px 20px;" onclick="generateQR()"><i class="fa-solid fa-sync"></i> Tạo QR</button>
                </div>

                <div class="url-text" id="currentUrlText"></div>

                <div class="qr-display" id="qrCodeContainer"></div>

                <div class="qr-actions">
                    <button class="cta-btn" onclick="copyURL()"><i class="fa-solid fa-copy"></i> Sao Chép Link</button>
                    <a id="downloadBtn" download="QR_DienTuVienThong.png" class="cta-btn" style="border-color: var(--accent-pink); color: var(--accent-pink); display: none;">
                        <i class="fa-solid fa-download"></i> Tải Mã QR (.PNG)
                    </a>
                </div>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer>
        <p>© 2026 Trang Web Giới Thiệu Ngành Điện Tử Viễn Thông | Electronics & Telecommunications Engineering</p>
    </footer>

    <!-- Script điều khiển Canvas & Mã QR -->
    <script>
        // 1. Khởi tạo mã QR Code
        let qrInstance = null;

        function initQR() {
            let currentUrl = window.location.href;
            document.getElementById('qrInput').value = currentUrl;
            document.getElementById('currentUrlText').innerText = "Link hiện tại: " + currentUrl;
            
            makeQR(currentUrl);
        }

        function makeQR(text) {
            const container = document.getElementById('qrCodeContainer');
            container.innerHTML = "";

            qrInstance = new QRCode(container, {
                text: text,
                width: 200,
                height: 200,
                colorDark : "#000000",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });

            setTimeout(() => {
                const img = container.querySelector('img');
                const canvas = container.querySelector('canvas');
                const downloadBtn = document.getElementById('downloadBtn');

                if (img && img.src) {
                    downloadBtn.href = img.src;
                    downloadBtn.style.display = 'inline-block';
                } else if (canvas) {
                    downloadBtn.href = canvas.toDataURL("image/png");
                    downloadBtn.style.display = 'inline-block';
                }
            }, 300);
        }

        function generateQR() {
            let val = document.getElementById('qrInput').value.trim();
            if (!val) return;
            if (!val.startsWith('http://') && !val.startsWith('https://')) {
                val = 'https://' + val;
            }
            document.getElementById('currentUrlText').innerText = "Link đang tạo: " + val;
            makeQR(val);
        }

        function copyURL() {
            const input = document.getElementById('qrInput');
            navigator.clipboard.writeText(input.value);
            alert("Đã sao chép đường link: " + input.value);
        }

        window.onload = function() {
            initQR();
            startWaveAnimation();
        };

        // 2. Mô phỏng Sóng Viễn Thông (Canvas Animation)
        const canvas = document.getElementById('waveCanvas');
        const ctx = canvas.getContext('2d');
        let waveType = 'sine';
        let step = 0;

        function setWave(type) {
            waveType = type;
            document.querySelectorAll('.controls .btn-small').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
        }

        function startWaveAnimation() {
            function resizeCanvas() {
                canvas.width = canvas.parentElement.clientWidth;
                canvas.height = 150;
            }
            resizeCanvas();

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#00f0ff';
                ctx.beginPath();

                const width = canvas.width;
                const height = canvas.height;
                const centerY = height / 2;

                for (let x = 0; x < width; x++) {
                    let y = centerY;

                    if (waveType === 'sine') {
                        y = centerY + Math.sin((x + step) * 0.03) * 40;
                    } else if (waveType === 'am') {
                        let carrier = Math.sin((x + step) * 0.1);
                        let signal = (Math.sin((x + step) * 0.01) + 1.2) / 2;
                        y = centerY + carrier * signal * 45;
                    } else if (waveType === 'digital') {
                        let val = Math.sin((x + step) * 0.04);
                        y = centerY + (val > 0 ? -35 : 35);
                    }

                    if (x === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }

                ctx.stroke();
                step += 2;
                requestAnimationFrame(draw);
            }

            draw();
        }
    </script>
</body>
</html>
